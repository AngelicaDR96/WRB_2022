# --- settings --- #
output_path = your_out_path

# --- read the database --- #
df = your_db
sec_col, pri_col, rsg_col = "Supplementary Qualifiers", "Principal Qualifiers", "Reference Soil Group"

# --- lookup code for soil_types dictionary --- #
name_by_code = {v['code']: v['name'] for v in qualifiers.values()}
code_by_name = {n.lower(): c for c, n in name_by_code.items()}

def qualifier_name(code):
    return name_by_code[code]

# --- define prefixes --- #
PREFIXES = ("amphi", "ano", "bathy", "cumuli", "dorsi", "endo", "epi", "ekto", "hyper",
            "hypo", "kato", "panto", "poly", "proto", "thapto", "ano", "bathy", "orthi")

# --- functions --- #
def to_code(item):
    item = str(item).strip()
    if item in name_by_code:                
        return item
    low = item.lower()
    for p in PREFIXES:                        # 'Endoleptic' -> 'le'
        if low.startswith(p) and low[len(p):] in code_by_name:
            return code_by_name[low[len(p):]]
    if low in code_by_name:                   
        return code_by_name[low]
    return item                              

def flatten(x):
    if isinstance(x, (list, tuple, set)):
        for i in x:
            yield from flatten(i)             # ricorsione a qualsiasi profondità
    else:
        yield to_code(x)

def code_of(cell):
    return None if pd.isna(cell) else str(cell).split(" - ")[0].strip()

def check(code, rsg, own, other):
    if code is None:
        return "NaN"
    if rsg not in allowed:
        return "unknown RSG"
    if code not in name_by_code:
        return "wrong code-name"
    if code in allowed[rsg][own]:
        return "OK"
    if code in allowed[rsg][other]:
        return f"allowed as {'supplementary' if other=='suppl' else 'principal'}"
    return "not allowed for this RSG"

def name_ok(cell):
    if pd.isna(cell): return True
    c, _, n = str(cell).partition(" - ")
    return name_by_code.get(c.strip(), "").lower() == n.strip().lower()

def save(df: pd.DataFrame, name: str) -> None:
    df.to_excel(out_dir / name, index=False)
    print(f"[saved] {name:<75} righe: {len(df)}")

# --- distinguish allowed qualifiers for each soil type --- #
allowed = {
    v['code']: {
        'principal': set(flatten(v['Principal_qualifiers'])),
        'suppl':     set(flatten(v['Supplementary_qualifiers'])),
    }
    for v in soil_types.values()
}

df["rsg_code"]  = df[rsg_col].map(code_of)
df["pri_code"]  = df[pri_col].map(code_of)
df["sup_code"]  = df[sec_col].map(code_of)
df["check_principal"] = [check(c, r, "principal", "suppl") for c, r in zip(df.pri_code, df.rsg_code)]
df["check_supplementary"] = [check(c, r, "suppl", "principal") for c, r in zip(df.sup_code, df.rsg_code)]
df["check_code-name"] = df[pri_col].map(name_ok) & df[sup_col].map(name_ok)

# --- wrong classification report --- #
errors = df[(~df.check_principal.isin(["OK", "NaN"])) |
            (~df.check_supplementary.isin(["OK", "NaN"])) | (~df.check_code-name)]
save(errors, output_path)
